# --- API (server/) ---
PORT=8787
# Leave MONGO_URL empty for local development: an embedded MongoDB starts automatically.
MONGO_URL=
MONGO_DB=mytno
CORS_ORIGIN=*

# --- Web (vite) ---
# Point the site at the API. Empty means "no backend": the app still works,
# calling the public services directly and making self-contained share links.
VITE_API_URL=http://localhost:8787
# Analytics: leave empty to run without any. Plausible is cookieless, GA asks for consent.
VITE_PLAUSIBLE_DOMAIN=
VITE_GA_ID=
